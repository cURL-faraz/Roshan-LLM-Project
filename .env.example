# Django secret key.
# Generate a new one with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-this-with-your-own-secret-key

# Enable Django debug mode.
# Use 1 for local development and 0 for production/Docker.
DJANGO_DEBUG=1

# Comma-separated list of hosts allowed to access the application.
# For local development:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouter (chat LLM). Get a key at https://openrouter.ai/keys. Never commit the real key.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Chat model id. Free models end in ":free" and change over time; list them with:
# curl -s https://openrouter.ai/api/v1/models | python -c "import json,sys;[print(m['id']) for m in json.load(sys.stdin)['data'] if m['id'].endswith(':free')]"
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Seconds before an LLM call is abandoned (our factory converts to the SDK's milliseconds).
OPENROUTER_TIMEOUT=60

# Local embedding model (sentence-transformers). Changing it requires re-indexing all documents.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
