# Secrets: real keys live only in .env, and .env.example is committed instead
.env

# Python bytecode caches, which Python regenerates automatically
__pycache__/
*.pyc

# Runtime data: the database, Chroma index and uploaded files are created by the app, not source code
data/
media/
db.sqlite3

# Collected static files, generated by `collectstatic`
staticfiles/

# Tooling and OS noise
.pytest_cache/
.DS_Store
.vscode/
.idea/

# Claude's local per-user settings (the shared .claude/skills/ stays tracked)
.claude/settings.local.json
